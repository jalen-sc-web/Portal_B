# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR HTTP (EXPRESS)
# ==============================================================================

# Puerto en el que la API escuchará las conexiones HTTP entrantes.
# Utilizado en: src/portal.js
PORT=5610

# Entorno de ejecución (ej. LOCAL, DEVELOPMENT, QA, PRODUCTION).
# Utilizado con fines de contexto/despliegue del entorno.
DEV=LOCAL

# Origen permitido para CORS (Cross-Origin Resource Sharing).
# Es la URL del cliente frontend (por ejemplo, el portal web en Angular).
# Utilizado en: src/portal.js
CLIENT_ORIGIN=http://localhost:4200


# ==============================================================================
# CONEXIÓN 1: BASE DE DATOS ORACLE - CORE ACSEL / CONSSEG (Usuario JALEN)
# Utilizada para consultar Clientes, Titulares, Pólizas y Catálogos Maestros.
# ==============================================================================

# IP o hostname del servidor de base de datos de Acsel.
ACSEL_SERVER_BD=10.0.0.75

# Puerto del listener de Oracle en el servidor Acsel.
ACSEL_PORT_BD=1521

# Service name de Oracle para Acsel (ej. QA, XE, PROD).
ACSEL_SERVICE_NAME_BD=QA

# Usuario de Oracle con permisos sobre el esquema Acsel (ej. JALEN).
ACSEL_USER_BD=JALEN

# Contraseña del usuario Acsel.
ACSEL_PASSWORD_BD=PASSWORD_ACSEL

# Esquema de Acsel donde residen CLIENTE, TERCERO, PAIS, etc. (por defecto CONSSEG).
ACSEL_SCHEMA=CONSSEG

# Parámetros del connection pool para Acsel
ACSEL_DB_POOL_MIN=2
ACSEL_DB_POOL_MAX=20
ACSEL_DB_POOL_TIMEOUT=60


# ==============================================================================
# CONEXIÓN 2: BASE DE DATOS ORACLE - WEBPORTAL (Usuario LUCOVIS)
# Utilizada exclusivamente para Autenticación, Usuarios y Credenciales del Portal.
# ==============================================================================

# IP o hostname del servidor de base de datos de WebPortal (puede ser diferente a Acsel).
PORTAL_SERVER_BD=10.0.0.80

# Puerto del listener de Oracle en el servidor WebPortal.
PORTAL_PORT_BD=1521

# Service name de Oracle para WebPortal (ej. QA, XE, PROD).
PORTAL_SERVICE_NAME_BD=QA

# Usuario de Oracle propietario o con acceso a la tabla USUARIO (ej. LUCOVIS).
PORTAL_USER_BD=LUCOVIS

# Contraseña del usuario LUCOVIS.
PORTAL_PASSWORD_BD=PASSWORD_PORTAL

# Esquema del Portal donde residen USUARIO y futuras tablas (por defecto WEBPORTAL).
PORTAL_SCHEMA=WEBPORTAL

# Parámetros del connection pool para WebPortal
PORTAL_DB_POOL_MIN=2
PORTAL_DB_POOL_MAX=20
PORTAL_DB_POOL_TIMEOUT=60

# [OPCIONAL] Ruta del directorio del Oracle Instant Client en el servidor/máquina.
# Si esta variable NO se define, el backend corre automáticamente en "Thin Mode" nativo
# de oracledb v6 (100% JavaScript, sin necesidad de librerías C instaladas).
# Solo descomentar si se requiere forzar "Thick Mode" explícitamente.
# ORACLE_CLIENT_DIR=C:\oracle\instantclient_19_8


# ==============================================================================
# AUTENTICACIÓN Y SEGURIDAD (JWT)
# ==============================================================================

# Clave secreta criptográfica utilizada para firmar y verificar tokens JSON Web Token (JWT).
# Debe ser una cadena de texto larga, aleatoria y protegida.
# Utilizada en: src/services/authService.js y src/middlewares/authMiddleware.js
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui

# Clave maestra de rescate / emergencia ("Break-Glass Recovery Key").
# Permite sobreescribir la contraseña de cualquier usuario (incluyendo el admin)
# a través del endpoint protegido POST /apixportal/api/v1/auth/system/override-password
# mediante el encabezado HTTP: x-recovery-key.
# Debe tener al menos 16 caracteres aleatorios de alta entropía.
# Utilizada en: src/middlewares/authMiddleware.js (verifyRecoveryKey)
ADMIN_RECOVERY_KEY=clave_maestra_de_rescate_emergencia_minimo_16_caracteres


# ==============================================================================
# SERVIDOR DE CORREOS SMTP (NOTIFICACIONES Y RECUPERACIÓN DE CONTRASEÑA)
# ==============================================================================

# Servidor host del proveedor de correo (ej. smtp.gmail.com).
# Utilizado en: src/utils/mailer.js
SMTP_HOST=smtp.gmail.com

# Puerto de conexión SMTP (587 para TLS/STARTTLS, 465 para SSL directo).
# Utilizado en: src/utils/mailer.js
SMTP_PORT=587

# Define si la conexión utiliza SSL directo (true para puerto 465, false para 587).
# Utilizado en: src/utils/mailer.js
SMTP_SECURE=false

# Dirección de correo o cuenta de usuario autenticada en el servidor SMTP.
# En Gmail, corresponde a tu dirección de correo (ej. tu_correo@gmail.com).
# Utilizado en: src/utils/mailer.js
SMTP_USER=tu_correo@gmail.com

# Contraseña de la cuenta de correo o "Contraseña de Aplicación" (App Password en Gmail).
# Utilizado en: src/utils/mailer.js
SMTP_PASS=tu_contrasena_de_aplicacion_gmail

# Remitente visible en los correos enviados por la plataforma.
# Utilizado en: src/utils/mailer.js
SMTP_FROM="Seguros Constitución" <no-reply@constitucion.com>

# URL base pública del frontend Angular para construir enlaces en correos.
# Utilizado en: src/utils/mailer.js
FRONTEND_URL=http://localhost:4200

# Lista blanca de destinatarios permitidos para envío de correos (separados por coma).
# Evita envíos accidentales a clientes reales en ambientes de desarrollo o pruebas.
# Soporta correos exactos (ej. tu_correo@gmail.com) y dominios completos (ej. *@constitucion.com o @constitucion.com).
# Dejar vacío o '*' para permitir envíos a cualquier destinatario (producción).
# Utilizado en: src/utils/mailer.js
EMAIL_WHITELIST=*@segurosconstitucion.com,tu_correo@gmail.com

# Tiempo mínimo de espera (cooldown en segundos) entre solicitudes de restablecimiento para una misma cuenta o correo.
# Previene el bombardeo de correos (inbox bombing) y ataques DoS dirigidos.
# Por defecto: 180 (3 minutos).
# Utilizado en: src/services/authService.js
RESET_PASSWORD_COOLDOWN_SECONDS=180
